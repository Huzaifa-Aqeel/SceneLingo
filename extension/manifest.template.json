{
  "manifest_version": 3,
  "name": "SceneLingo",
  "version": "2.0.0",
  "description": "Click a subtitle while you watch to save it. Learn it later in SceneLingo.",
  "key": "__KEY__",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": "__HOST_PERMISSIONS__",
  "action": { "default_title": "Open SceneLingo", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "externally_connectable": { "matches": "__EXTERNAL_MATCHES__" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
