rules_version = '2';

// SceneLingo: everything lives under users/{uid} and is readable/writable only by that user.
// No wildcard under users/{uid}: each collection is listed explicitly, because overlapping
// wildcard matches are OR-ed together and would silently widen the capture rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A capture as created by the extension over the REST API (FR-FB-008). The limits here
    // must match extension/src/lib/validate.js.
    function validCapture(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'ownerUid', 'text', 'sentences', 'editedText', 'platform', 'videoId', 'videoTitle',
               'videoUrl', 'playbackTimeSeconds', 'subtitleLanguage', 'capturedAt', 'syncedAt',
               'status', 'savedCardIds', 'schemaVersion'
             ])
          && d.keys().hasAll([
               'ownerUid', 'text', 'sentences', 'platform', 'videoTitle', 'videoUrl',
               'playbackTimeSeconds', 'capturedAt', 'syncedAt', 'status', 'schemaVersion'
             ])
          && d.ownerUid == uid
          && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
          && d.sentences is list && d.sentences.size() > 0 && d.sentences.size() <= 50
          && d.platform in ['youtube', 'netflix']
          && (d.get('videoId', null) == null || (d.videoId is string && d.videoId.size() <= 64))
          && d.videoTitle is string && d.videoTitle.size() <= 300
          && d.videoUrl is string && d.videoUrl.size() <= 2048 && d.videoUrl.matches('^https://.*')
          && d.playbackTimeSeconds is number && d.playbackTimeSeconds >= 0
          && d.capturedAt is timestamp
          && d.syncedAt == request.time
          && d.status == 'new'
          && d.get('editedText', null) == null
          && d.get('savedCardIds', []).size() == 0
          && d.schemaVersion == 1;
    }

    // What the web application may change on a capture afterwards.
    function validCaptureUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'editedText', 'savedCardIds', 'updatedAt'])
          && request.resource.data.status in ['new', 'processed', 'dismissed']
          && (request.resource.data.get('editedText', null) == null
              || (request.resource.data.editedText is string && request.resource.data.editedText.size() <= 1000));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /captures/{captureId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validCapture(uid);
        allow update: if isOwner(uid) && validCaptureUpdate();
        allow delete: if isOwner(uid);
      }

      match /learningCards/{cardId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.selectedText is string
          && request.resource.data.selectedText.size() <= 1000
          && request.resource.data.sourceSentence is string
          && request.resource.data.sourceSentence.size() <= 1000;
      }

      // History is append-only: events are created, never edited.
      match /reviewEvents/{eventId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.cardId is string
          && request.resource.data.result in ['correct', 'incorrect'];
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /settings/{docId} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && (!request.resource.data.keys().hasAny(['nativeLanguage'])
              || (request.resource.data.nativeLanguage is string
                  && request.resource.data.nativeLanguage.matches('^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})?$')));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
